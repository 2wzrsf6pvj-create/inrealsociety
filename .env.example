# Copie ce fichier en .env.local et remplis les valeurs.
# .env.local est gitignoré — ne jamais commit de clés.

# ─── Supabase (REQUIS) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── App (REQUIS) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Emails (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# ─── Printful (POD t-shirts) ──────────────────────────────────────────────────
PRINTFUL_API_TOKEN=
PRINTFUL_VARIANT_ID_DARK=
PRINTFUL_VARIANT_ID_LIGHT=

# ─── Upstash Redis (rate limiting) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── PostHog (analytics) ──────────────────────────────────────────────────────
# Project API key depuis app.posthog.com → Project Settings → "Project API Key"
NEXT_PUBLIC_POSTHOG_KEY=
# Cloud EU par défaut (RGPD). Cloud US : https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── OpenAI (modération de contenu) ───────────────────────────────────────────
# Endpoint /v1/moderations gratuit (pas facturé). Sans clé, fallback regex.
OPENAI_API_KEY=

# ─── Sentry (error tracking) ──────────────────────────────────────────────────
# DSN public (safe à exposer). Sans DSN, Sentry est no-op.
NEXT_PUBLIC_SENTRY_DSN=
# Pour upload des source maps (optionnel mais recommandé en prod) :
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
