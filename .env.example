# Copie ce fichier en .env.local et remplis les valeurs.
# .env.local est gitignoré — ne jamais commit de clés.

# ─── Supabase (REQUIS) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── App (REQUIS) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Emails (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Clé réelle (sk_live_ ou rk_live_) : une commande payée est confirmée chez
# l'imprimeur, donc imprimée. Clé de test : elle reste en brouillon (recette).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# ─── Printful (POD t-shirts) ──────────────────────────────────────────────────
PRINTFUL_API_TOKEN=
# ⚠️ IMPORTANT : un variant_id Printful encode COULEUR **ET** TAILLE. Sans les
# variables PAR TAILLE ci-dessous, TOUTES les commandes partent à la taille figée
# dans le fallback → le client reçoit la mauvaise taille. Renseigner les 10
# (5 tailles × 2 couleurs) depuis le catalogue Printful (Comfort Colors 1717).
PRINTFUL_VARIANT_ID_DARK_S=
PRINTFUL_VARIANT_ID_DARK_M=
PRINTFUL_VARIANT_ID_DARK_L=
PRINTFUL_VARIANT_ID_DARK_XL=
PRINTFUL_VARIANT_ID_DARK_XXL=
PRINTFUL_VARIANT_ID_LIGHT_S=
PRINTFUL_VARIANT_ID_LIGHT_M=
PRINTFUL_VARIANT_ID_LIGHT_L=
PRINTFUL_VARIANT_ID_LIGHT_XL=
PRINTFUL_VARIANT_ID_LIGHT_XXL=
# Fallback legacy (mono-taille) — utilisé seulement si la variable par taille est
# absente. À laisser vide en prod une fois les 10 ci-dessus renseignées.
PRINTFUL_VARIANT_ID_DARK=
PRINTFUL_VARIANT_ID_LIGHT=

# Quand imprimer le t-shirt. Vide/absent = défaut = AU PAIEMENT : on réserve le
# short_code du QR sur la commande et on imprime tout de suite (l'acheteur reçoit
# toujours son tee ; le profil s'active ensuite, le QR en hérite). Mettre 'false'
# pour revenir au modèle « imprimer À L'ACTIVATION » (rollback sans redéploiement).
FULFILL_ON_PAYMENT=

# ─── Gelato (POD alternatif — fulfillment EU) ─────────────────────────────────
# Bascule le POD : 'gelato' pour utiliser Gelato, sinon Printful (défaut).
# ⚠️ NE PAS mettre 'gelato' en prod tant que les productUid + suivi/annulation ne
# sont pas validés (cf. src/lib/gelato.ts). Reco blank : Stanley/Stella Sparker 2.0.
FULFILLMENT_PROVIDER=
GELATO_API_KEY=
# Méthode d'expédition Gelato ('normal' | 'express' | 'standard'… selon le compte).
GELATO_SHIPMENT_METHOD_UID=
# productUid par (couleur × taille). Les sortir : GELATO_API_KEY=xxx node scripts/gelato-variants.mjs
GELATO_PRODUCT_UID_DARK_S=
GELATO_PRODUCT_UID_DARK_M=
GELATO_PRODUCT_UID_DARK_L=
GELATO_PRODUCT_UID_DARK_XL=
GELATO_PRODUCT_UID_DARK_XXL=
GELATO_PRODUCT_UID_LIGHT_S=
GELATO_PRODUCT_UID_LIGHT_M=
GELATO_PRODUCT_UID_LIGHT_L=
GELATO_PRODUCT_UID_LIGHT_XL=
GELATO_PRODUCT_UID_LIGHT_XXL=
# Fallback legacy mono-taille (comme Printful) — laisser vide une fois les 10 ci-dessus.
GELATO_PRODUCT_UID_DARK=
GELATO_PRODUCT_UID_LIGHT=

# ─── Upstash Redis (rate limiting) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# ⚠️ MÊME valeur que VAPID_PUBLIC_KEY, exposée au client (ConversationClient en a
# besoin pour s'abonner au push). Sans elle, le push est cassé côté navigateur.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Optionnel : sujet VAPID (défaut : mailto:hello@inrealsociety.com)
VAPID_SUBJECT=

# ─── PostHog (analytics) ──────────────────────────────────────────────────────
# Project API key depuis app.posthog.com → Project Settings → "Project API Key"
NEXT_PUBLIC_POSTHOG_KEY=
# Cloud EU par défaut (RGPD). Cloud US : https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── OpenAI (modération de contenu) ───────────────────────────────────────────
# Endpoint /v1/moderations gratuit (pas facturé). Sans clé, fallback regex.
OPENAI_API_KEY=

# ─── Alertes modération ──────────────────────────────────────────────────────
# Reçoit une alerte à chaque message signalé par un porteur (et les bannissements
# automatiques). Sans elle, personne n'est prévenu.
ADMIN_ALERT_EMAIL=

# Administration de la modération (/admin) : emails autorisés, séparés par des
# virgules. Le compte doit exister et son adresse être confirmée.
ADMIN_EMAILS=

# ─── Sentry (error tracking) ──────────────────────────────────────────────────
# DSN public (safe à exposer). Sans DSN, Sentry est no-op.
NEXT_PUBLIC_SENTRY_DSN=
# Pour upload des source maps (optionnel mais recommandé en prod) :
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Cron (Vercel Cron / cleanup) ─────────────────────────────────────────────
# Secret partagé entre Vercel Cron et les routes /api/cron/*.
# Vercel l'injecte automatiquement dans le header Authorization: Bearer.
CRON_SECRET=

# ─── Programme de parrainage (Stripe Coupon) ──────────────────────────────────
# ID d'un Stripe Coupon créé manuellement dans le dashboard (ex: -10€ ou -10%).
# Appliqué automatiquement au checkout shop quand le visiteur arrive avec ?ref=<memberId>.
# Sans valeur, le parrainage reste actif mais sans remise (stat seulement).
# ⚠️ PLAFONNER le coupon (max_redemptions / durée) : l'UUID parrain est public →
# sans plafond, la remise est cumulable à l'infini (coût marketing non borné).
STRIPE_REFERRAL_COUPON_ID=

# ─── Divers ───────────────────────────────────────────────────────────────────
# Secret des endpoints internes /api/push/notify ET /api/newsletter/send
# (fail-closed si absent). Génère-le : openssl rand -hex 32
INTERNAL_SECRET=
# Domaine court pour les QR (ex: https://inreal.me).
# Sans valeur, les QR encodent ${NEXT_PUBLIC_APP_URL}/r/<code>.
# ⚠️ À LAISSER VIDE pour l'instant : rien ne redirige encore le domaine court
# vers /r/<code>. Renseigné, chaque QR imprimé mènerait à une page introuvable.
#
# ⚠️ CE N'EST PAS QU'UNE COQUETTERIE : la largeur imprimée du QR est FIXE (25 cm),
# donc une URL plus longue = plus de modules = modules plus petits = QR lisible de
# MOINS LOIN. 'https://inreal.me/A7kQ' → 29 modules → ~2,5 m de portée de scan.
# 'https://<app>.vercel.app/r/A7kQ'    → 37 modules → ~2,0 m (−22 %).
# fulfillOrder émet un warning quand le QR dépasse 29 modules.
SHORT_DOMAIN=
