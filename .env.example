# Copie ce fichier en .env.local et remplis les valeurs.
# .env.local est gitignoré — ne jamais commit de clés.
#
# Toutes les clés et API de l'app. En production (Vercel → Settings →
# Environment Variables), ce qu'il faut et ce que chaque variable empêche :
# docs/MISE_EN_PRODUCTION.md, section 1. Une fois en ligne, /admin →
# « Configuration » dit ce que l'app voit, sans jamais afficher un secret.

# ─── Supabase (REQUIS) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── App (REQUIS) ─────────────────────────────────────────────────────────────
# En production : le domaine définitif (liens des emails, pages des profils).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Emails (Resend) ──────────────────────────────────────────────────────────
# Sans clé : aucun email (code d'activation, notifications, confirmations).
RESEND_API_KEY=
# Optionnel : expéditeur. Défaut : In Real Society <noreply@mail.inrealsociety.com>
# (domaine d'envoi vérifié chez Resend).
EMAIL_FROM=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Clé réelle (sk_live_ ou rk_live_) : une commande payée est confirmée chez
# l'imprimeur, donc imprimée. Clé de test : elle reste en brouillon (recette).
STRIPE_SECRET_KEY=
# Price du t-shirt (49 €, « inclusive »).
STRIPE_PRICE_ID=
# Webhook vers https://<domaine>/api/webhook/stripe (événements :
# docs/DEPLOY_CHECKLIST.md, section 2).
STRIPE_WEBHOOK_SECRET=
# Price du premium (2,99 €/mois, « inclusive »).
STRIPE_PREMIUM_PRICE_ID=

# ─── Printful (impression des t-shirts) ───────────────────────────────────────
# Une carte de paiement doit être enregistrée chez Printful : il débite chaque
# impression.
PRINTFUL_API_TOKEN=
# ⚠️ IMPORTANT : un variant_id Printful encode COULEUR **ET** TAILLE. Sans les
# variables PAR TAILLE ci-dessous, TOUTES les commandes partent à la taille figée
# dans le fallback → le client reçoit la mauvaise taille. Renseigner les 10
# (5 tailles × 2 couleurs) depuis le catalogue Printful (Comfort Colors 1717) :
# PRINTFUL_API_TOKEN=xxx node scripts/printful-variants.mjs "1717" les liste.
PRINTFUL_VARIANT_ID_DARK_S=
PRINTFUL_VARIANT_ID_DARK_M=
PRINTFUL_VARIANT_ID_DARK_L=
PRINTFUL_VARIANT_ID_DARK_XL=
PRINTFUL_VARIANT_ID_DARK_XXL=
PRINTFUL_VARIANT_ID_LIGHT_S=
PRINTFUL_VARIANT_ID_LIGHT_M=
PRINTFUL_VARIANT_ID_LIGHT_L=
PRINTFUL_VARIANT_ID_LIGHT_XL=
PRINTFUL_VARIANT_ID_LIGHT_XXL=
# Fallback legacy (mono-taille) — utilisé seulement si la variable par taille est
# absente. À laisser vide en prod une fois les 10 ci-dessus renseignées.
PRINTFUL_VARIANT_ID_DARK=
PRINTFUL_VARIANT_ID_LIGHT=

# Quand imprimer le t-shirt. Vide/absent = défaut = AU PAIEMENT : on réserve le
# short_code du QR sur la commande et on imprime tout de suite (l'acheteur reçoit
# toujours son tee ; le profil s'active ensuite, le QR en hérite). Mettre 'false'
# pour revenir au modèle « imprimer À L'ACTIVATION » : sans changer le code, mais
# en redéployant (une variable ne compte qu'au déploiement suivant).
FULFILL_ON_PAYMENT=

# ─── Gelato (POD alternatif — fulfillment EU) ─────────────────────────────────
# Bascule le POD : 'gelato' pour utiliser Gelato, sinon Printful (défaut).
# ⚠️ NE PAS mettre 'gelato' en prod tant que les productUid + suivi/annulation ne
# sont pas validés (cf. src/lib/gelato.ts). Reco blank : Stanley/Stella Sparker 2.0.
FULFILLMENT_PROVIDER=
GELATO_API_KEY=
# Méthode d'expédition Gelato (défaut 'normal' : livraison standard, la seule vendue).
GELATO_SHIPMENT_METHOD_UID=
# productUid par (couleur × taille). Les sortir : GELATO_API_KEY=xxx node scripts/gelato-variants.mjs
# (GELATO_CATALOG_UID et GELATO_FILTER, facultatifs, affinent la recherche).
GELATO_PRODUCT_UID_DARK_S=
GELATO_PRODUCT_UID_DARK_M=
GELATO_PRODUCT_UID_DARK_L=
GELATO_PRODUCT_UID_DARK_XL=
GELATO_PRODUCT_UID_DARK_XXL=
GELATO_PRODUCT_UID_LIGHT_S=
GELATO_PRODUCT_UID_LIGHT_M=
GELATO_PRODUCT_UID_LIGHT_L=
GELATO_PRODUCT_UID_LIGHT_XL=
GELATO_PRODUCT_UID_LIGHT_XXL=
# Fallback legacy mono-taille (comme Printful) — laisser vide une fois les 10 ci-dessus.
GELATO_PRODUCT_UID_DARK=
GELATO_PRODUCT_UID_LIGHT=

# ─── Upstash Redis (limites de débit, REQUIS) ─────────────────────────────────
# Sans elles : scanner un QR, écrire, signaler → erreur (les limites échouent
# fermées).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Notifications (Web Push, VAPID) — indispensables pour le test terrain ───
# Sans elles, aucune notification : un message n'est vu qu'en ouvrant le site.
# Générer la paire : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# ⚠️ MÊME valeur que VAPID_PUBLIC_KEY, exposée au navigateur (« Mon espace » du
# porteur, conversation du passant). Différente : aucune notification n'arrive.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Optionnel : sujet VAPID (défaut : mailto:hello@inrealsociety.com)
VAPID_SUBJECT=

# ─── PostHog (analytics) ──────────────────────────────────────────────────────
# Project API key depuis app.posthog.com → Project Settings → "Project API Key".
# Mesure seulement les visiteurs qui l'acceptent (bandeau des cookies).
NEXT_PUBLIC_POSTHOG_KEY=
# Cloud EU par défaut (RGPD). Cloud US : https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── OpenAI (modération de contenu) ───────────────────────────────────────────
# Endpoint /v1/moderations gratuit (pas facturé). Sans clé, fallback regex.
OPENAI_API_KEY=

# ─── Alertes et administration ────────────────────────────────────────────────
# Reçoit les signalements (messages, profils), les bannissements automatiques et
# les alertes « argent » (paiement sans commande, code non envoyé, t-shirt non
# transmis ou resté en brouillon chez Printful, webhook Stripe en échec…). Sans
# elle, personne n'est prévenu.
ADMIN_ALERT_EMAIL=

# /admin (modération, chiffres et suivi du test terrain, premium offert,
# commandes, configuration) : emails autorisés, séparés par des virgules. Le
# compte doit exister et son adresse être confirmée.
ADMIN_EMAILS=

# ─── Sentry (error tracking) ──────────────────────────────────────────────────
# DSN public (safe à exposer). Sans DSN, Sentry est no-op.
NEXT_PUBLIC_SENTRY_DSN=
# Pour upload des source maps (optionnel mais recommandé en prod) :
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Tâches planifiées (Vercel Cron) ──────────────────────────────────────────
# Secret partagé entre Vercel Cron et les routes /api/cron/* : Vercel l'envoie
# dans le header Authorization: Bearer. Sans lui, les 5 tâches de vercel.json
# sont refusées (purge RGPD, relances de scan et d'activation, premium et fin du
# premium offert, rattrapage d'impression).
CRON_SECRET=

# ─── Programme de parrainage (Stripe Coupon) ──────────────────────────────────
# ID d'un Stripe Coupon créé manuellement dans le dashboard (ex: -10€ ou -10%).
# Appliqué au checkout quand le visiteur arrive par le lien d'un porteur
# (/join/<code> ; l'ancien lien à identifiant reste valable). Sans valeur, le
# parrainage reste actif mais sans remise (stat seulement).
# ⚠️ PLAFONNER le coupon (max_redemptions / durée) : un lien de parrainage
# circule librement → sans plafond, la remise est cumulable à l'infini.
STRIPE_REFERRAL_COUPON_ID=

# ─── Divers ───────────────────────────────────────────────────────────────────
# Secret des liens signés des emails (désinscription en un clic) et des
# endpoints internes /api/push/notify et /api/newsletter/send (fail-closed si
# absent). Génère-le : openssl rand -hex 32
INTERNAL_SECRET=
# Domaine court des QR imprimés (choix de Clément : https://inreal.me),
# indispensable pour le test terrain.
# Sans valeur, les QR encodent ${NEXT_PUBLIC_APP_URL}/r/<code>.
# Le domaine doit être ajouté au MÊME projet Vercel, SANS redirection vers le
# domaine principal : l'app (src/proxy.ts) envoie elle-même inreal.me/<code>
# vers le profil, et le reste vers le site. Avec une redirection Vercel, chaque
# QR imprimé mènerait à une page introuvable.
#
# ⚠️ CE N'EST PAS QU'UNE COQUETTERIE : la largeur imprimée du QR est FIXE (25 cm),
# donc une URL plus longue = plus de modules = modules plus petits = QR lisible de
# MOINS LOIN. 'https://inreal.me/A7kQ' → 29 modules → ~2,5 m de portée de scan.
# 'https://<app>.vercel.app/r/A7kQ'    → 37 modules → ~2,0 m (−22 %).
# fulfillOrder émet un warning quand le QR dépasse 29 modules.
SHORT_DOMAIN=
